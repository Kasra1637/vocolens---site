{
  "$schema": "https://opencode.ai/config.json",
  // Cross-repo session config: this session lives in vocolens---site and
  // also sees the Vocolens mobile app + TikTok internal video tool. Rules:
  // read all freely; commit and push each repo separately (never mixed);
  // show git status/diff per folder before committing; never force-push;
  // never commit secrets.
  "references": {
    "vocolens-app": { "path": "../Vocolens-app" },
    "tiktok": { "path": "../tiktok" }
  },
  "permission": {
    "external_directory": { "../Vocolens-app/**": "allow", "../tiktok/**": "allow" },
    "bash": { "git *": "allow" }
  }
}
